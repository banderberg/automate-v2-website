---
// Ft1 mast-headed: wordmark and one line of stance anchor the band. The link
// lists are the site's internal-link spine for the comparison pages.
import { competitors, CONTACT_EMAIL, PRICING_LINE } from '../lib/facts';
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="mast">
      <p class="footer-wordmark">AutoMate</p>
      <p class="footer-line">Car expenses, kept on your phone. {PRICING_LINE} Android only.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <div>
        <h2 class="footer-head">Compare AutoMate</h2>
        <ul>
          {competitors.map((c) => <li><a href={`/vs-${c.slug}/`}>vs {c.name}</a></li>)}
          <li><a href="/alternatives/">All alternatives</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer-head">Switch</h2>
        <ul>
          <li><a href="/switch-from-fuelio/">From Fuelio</a></li>
          <li><a href="/switch-from-drivvo/">From Drivvo</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer-head">More</h2>
        <ul>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>Email the developer</a></li>
        </ul>
      </div>
    </nav>
    <p class="colophon">
      Built by one independent developer. Google Play is a trademark of Google LLC. Other app names belong to their owners
      and are used here only to compare.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    border-top: 1px solid var(--color-rule);
    background: var(--color-card);
  }
  .footer-inner {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-lg);
    letter-spacing: -0.03em;
  }
  .footer-line {
    color: var(--color-ink-2);
    max-width: 30rem;
    margin-top: var(--space-2xs);
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-lg);
  }
  .footer-head {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
    letter-spacing: 0;
    margin-bottom: var(--space-xs);
  }
  .footer-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }
  .footer-links a {
    white-space: nowrap;
    color: var(--color-ink);
    text-decoration: none;
    font-size: var(--text-sm);
    display: inline-block;
    padding-block: var(--space-2xs);
  }
  .footer-links a:hover {
    color: var(--color-link);
    text-decoration: underline;
  }
  .colophon {
    font-size: var(--text-sm);
    color: var(--color-muted);
    border-top: 1px solid var(--color-rule);
    padding-top: var(--space-md);
    max-width: none;
  }
  @media (min-width: 60rem) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      align-items: start;
    }
    .colophon {
      grid-column: 1 / -1;
    }
  }
</style>
