---
import { featureSigns } from '../lib/content';

const icons: Record<string, string> = {
  fuel: 'M12 2S5 11 5 15a7 7 0 0 0 14 0c0-4-7-13-7-13Z',
  service:
    'M14.7 6.3a4 4 0 0 0-5.4 5.4L2 19l3 3 7.3-7.3a4 4 0 0 0 5.4-5.4l-2.8 2.8-2.8-2.8 2.8-2.8Z',
  expense:
    'M20.6 13.4 11 3.8A2 2 0 0 0 9.6 3.2L3 3a1 1 0 0 0-1 1l.2 6.6a2 2 0 0 0 .6 1.4l9.6 9.6a2 2 0 0 0 2.8 0l6.4-6.4a2 2 0 0 0 0-2.8ZM7.1 7.9a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z',
  insights: 'M13 2 3 14h7l-1 8 11-14h-7l1-6Z',
};
---

<section class="sign-panels" id="features" aria-labelledby="features-heading">
  <div class="section-inner">
    <h2 id="features-heading">Every kind of cost, one record.</h2>
    <div class="panels">
      {
        featureSigns.map((sign, i) => (
          <article class="sign-panel" data-accent={sign.accent} style={`--i:${i}`}>
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
              <path d={icons[sign.id]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />
            </svg>
            <h3>{sign.label}</h3>
            <p>{sign.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sign-panels {
    background: var(--road);
    color: var(--ticket-paper);
    padding: var(--space-4xl) clamp(1.25rem, 4vw, 3rem);
  }
  .section-inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  h2 {
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
    font-weight: 700;
    max-width: 20ch;
    margin-bottom: var(--space-2xl);
  }
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
  }
  .sign-panel {
    background: var(--sign-panel);
    border: 2px solid color-mix(in srgb, var(--accent-color) 40%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    animation: sign-light 520ms var(--ease-out-quart) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }
  .sign-panel[data-accent='fuel'] {
    --accent-color: var(--fuel);
  }
  .sign-panel[data-accent='service'] {
    --accent-color: var(--service);
  }
  .sign-panel[data-accent='expense'] {
    --accent-color: var(--expense);
  }
  .sign-panel[data-accent='primary'] {
    --accent-color: var(--primary);
  }
  .sign-panel svg {
    color: var(--accent-color);
    margin-bottom: var(--space-lg);
  }
  .sign-panel h3 {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-color);
    margin-bottom: var(--space-md);
  }
  .sign-panel p {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--ticket-paper) 78%, transparent);
    max-width: 32ch;
  }

  @keyframes sign-light {
    from {
      opacity: 0.4;
      filter: saturate(0.3);
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      filter: saturate(1);
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sign-panel {
      animation: none;
    }
  }
</style>
