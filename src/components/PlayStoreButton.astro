---
import { PLAY_STORE_URL } from '../lib/content';

interface Props {
  variant?: 'primary' | 'compact';
}
const { variant = 'primary' } = Astro.props;
---

<a
  class={`play-store-button ${variant}`}
  href={PLAY_STORE_URL}
  target="_blank"
  rel="noopener noreferrer"
  data-cta="play-store"
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M3.6 2.6c-.4.2-.6.6-.6 1v16.8c0 .4.2.8.6 1l9.6-9.4L3.6 2.6Zm11 9.4 2.8-2.7 3.6 2.1c.6.3.6 1.2 0 1.5l-3.6 2.1-2.8-2.7v-.3Zm-1.4 1.4-9 8.8 10.8-6.2-1.8-2.6Zm0-2.8 1.8-2.6L4.2 1.4l9 8.8Z"
    />
  </svg>
  <span>
    <span class="eyebrow">Get it on</span>
    <span class="store-name">Google Play</span>
  </span>
</a>

<style>
  .play-store-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    background: var(--primary);
    color: white;
    text-decoration: none;
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-lg);
    font-family: var(--font-display);
    font-weight: 700;
    transition: transform 180ms var(--ease-out-quart), background 180ms var(--ease-out-quart);
    white-space: nowrap;
  }
  .play-store-button:hover {
    transform: translateY(-2px);
    background: #37619f;
  }
  .play-store-button:active {
    transform: translateY(0);
  }
  .play-store-button span {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.7rem;
    /* full opacity: at this small size, dimmed white on the primary-blue
       button drops below 4.5:1 contrast */
  }
  .store-name {
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }
  .play-store-button.compact {
    padding: var(--space-sm) var(--space-lg);
  }
  .play-store-button.compact .eyebrow {
    display: none;
  }
  .play-store-button.compact .store-name {
    font-size: 0.85rem;
  }
</style>
