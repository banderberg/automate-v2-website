---
interface Props {
  trail: { name: string; path: string }[];
}
const { trail } = Astro.props;
---

<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    {
      trail.map((c, i) => (
        <li>
          {i < trail.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .crumbs li {
    white-space: nowrap;
  }
  .crumbs li:last-child {
    white-space: normal;
    min-width: 0;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-xs);
    color: var(--color-rule);
  }
  .crumbs a {
    color: var(--color-ink-2);
  }
</style>
