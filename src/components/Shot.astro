---
// A real app screenshot in a plain device mask: rounded corners and a hairline,
// no drawn bezel or notch. Optional numbered pins point at UI details; their
// numbers match the legend the caller renders beside the shot.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Pin {
  n: number;
  /** Position inside the visible frame, in percent. */
  x: number;
  y: number;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Visible portion as width/height. Defaults to the full screenshot. */
  ratio?: string;
  pins?: Pin[];
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  ratio,
  pins = [],
  eager = false,
  sizes = '(min-width: 60rem) 300px, 80vw',
  class: className,
} = Astro.props;
const frameRatio = ratio ?? `${src.width} / ${src.height}`;
---

<div class:list={['shot', className]} style={`--ratio: ${frameRatio}`}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[320, 480, 640, 900]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
    class="shot-img"
  />
  {
    pins.map((p) => (
      <span class="pin" style={`--x: ${p.x}%; --y: ${p.y}%`} aria-hidden="true">
        {p.n}
      </span>
    ))
  }
</div>

<style>
  .shot {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius-shot);
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    box-shadow: var(--shadow-shot);
  }
  .shot :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
  }
  .shot :global(.shot-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background: var(--color-pin);
    color: var(--color-on-pin);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 3px var(--color-paper);
    z-index: var(--z-raised);
  }
</style>
