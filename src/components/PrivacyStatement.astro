---
const commitments = [
  { title: 'No ads, ever', detail: 'Not disguised as features, not "ways to save." None.' },
  { title: 'No account, ever', detail: 'Nothing to sign up for, nothing to log into.' },
  { title: 'No data selling, ever', detail: 'Your car records are not the product.' },
  { title: 'No subscription required', detail: 'One optional $9.99 purchase. That\'s the whole model.' },
];
---

<section class="privacy" aria-labelledby="privacy-heading">
  <div class="section-inner">
    <div class="privacy-copy">
      <h2 id="privacy-heading">Built for you, not for advertisers.</h2>
      <p>
        AutoMate is built by a solo developer who was tired of car expense
        apps with intrusive ads, forced logins, and broken cloud sync. Your
        records live in a local database on your device — not on a server
        somewhere. AutoMate works fully offline; the only network call it
        ever makes is an optional VIN lookup against the free NHTSA public
        database.
      </p>
    </div>
    <ul class="commitments">
      {
        commitments.map((c) => (
          <li>
            <h3>{c.title}</h3>
            <p>{c.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .privacy {
    background: var(--surface);
    padding: var(--space-4xl) clamp(1.25rem, 4vw, 3rem);
  }
  .section-inner {
    max-width: 68rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(280px, 1.4fr);
    gap: var(--space-3xl);
    align-items: start;
  }
  h2 {
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.5rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-lg);
  }
  .privacy-copy p {
    color: var(--ink-secondary);
    max-width: 42ch;
  }
  .commitments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
  }
  .commitments li {
    background: var(--card);
    border: 1px solid var(--divider);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }
  .commitments h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }
  .commitments p {
    color: var(--ink-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 55rem) {
    .section-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
