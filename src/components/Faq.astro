---
// Native <details> disclosure: works without JavaScript and keeps every answer
// in the HTML for search engines. Emits FAQPage JSON-LD for the same items.
import type { FaqItem } from '../lib/facts';

interface Props {
  items: FaqItem[];
  heading?: string;
  id?: string;
}

const { items, heading = 'Questions', id = 'faq' } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<section class="faq" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{heading}</h2>
  <div class="faq-list">
    {
      items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq {
    display: grid;
    gap: var(--space-lg);
  }
  .faq-list {
    border-top: 1px solid var(--color-rule);
    max-width: 48rem;
  }
  details {
    border-bottom: 1px solid var(--color-rule);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-md);
    font-weight: 600;
    font-size: var(--text-md);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-muted);
    transition: transform var(--dur-short) var(--ease-out);
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    padding-bottom: var(--space-md);
    color: var(--color-ink-2);
    max-width: var(--measure);
  }
</style>
