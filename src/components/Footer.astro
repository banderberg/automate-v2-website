---
import PlayStoreButton from './PlayStoreButton.astro';
import { withBase } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="brand-row">
        <img src={withBase('/favicon.png')} alt="" width="32" height="32" />
        <span class="brand-name">AutoMate</span>
      </div>
      <p class="tagline">Know what your car actually costs you. Private, no accounts, fully offline.</p>
      <PlayStoreButton />
      <p class="platform-note">Available on Android via Google Play. iOS is not yet available.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <div>
        <h3>Site</h3>
        <a href={withBase('/#features')}>Features</a>
        <a href={withBase('/#compare')}>Compare</a>
        <a href={withBase('/#faq')}>FAQ</a>
        <a href={withBase('/blog/')}>Blog</a>
      </div>
      <div>
        <h3>Legal</h3>
        <a href={withBase('/privacy/')}>Privacy Policy</a>
      </div>
    </nav>
  </div>

  <p class="copyright">© {year} AutoMate. Built by a solo developer, not a data company.</p>
</footer>

<style>
  .site-footer {
    background: var(--road);
    color: var(--ticket-paper);
    padding: var(--space-4xl) clamp(1.25rem, 4vw, 3rem) var(--space-xl);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4xl);
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
    padding-bottom: var(--space-3xl);
    border-bottom: 1px solid var(--road-line);
  }
  .footer-brand {
    max-width: 26rem;
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }
  .brand-row img {
    border-radius: 7px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
  }
  .tagline {
    color: color-mix(in srgb, var(--ticket-paper) 75%, transparent);
    margin-bottom: var(--space-xl);
  }
  .platform-note {
    margin-top: var(--space-md);
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--ticket-paper) 55%, transparent);
  }
  .footer-links {
    display: flex;
    gap: var(--space-4xl);
  }
  .footer-links h3 {
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--ticket-paper) 55%, transparent);
    margin-bottom: var(--space-md);
  }
  .footer-links a {
    display: block;
    color: var(--ticket-paper);
    text-decoration: none;
    opacity: 0.85;
    margin-bottom: var(--space-sm);
  }
  .footer-links a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .copyright {
    max-width: 72rem;
    margin: var(--space-xl) auto 0;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--ticket-paper) 50%, transparent);
  }
</style>
