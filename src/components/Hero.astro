---
import PlayStoreButton from './PlayStoreButton.astro';
---

<section class="hero">
  <div class="road-texture" aria-hidden="true"></div>
  <div class="hero-inner">
    <h1>You already paid this.<br />You just don't know the number.</h1>
    <p class="hero-sub">
      Track fuel, service &amp; expenses. Private, no accounts, fully offline.
    </p>

    <div class="ticket-receipt" role="img" aria-label="A toll entry ticket becomes a receipt showing your real cost per mile">
      <div class="ticket">
        <span class="stub-label">ENTRY</span>
        <span class="stub-value tabular-nums">08:14</span>
        <span class="stub-label">MILE</span>
        <span class="stub-value tabular-nums">000</span>
      </div>

      <div class="lane" aria-hidden="true">
        <span class="lane-arrow">→</span>
      </div>

      <div class="receipt" data-reveal>
        <span class="stub-label">EXIT</span>
        <span class="redacted tabular-nums" data-redacted>????</span>
        <span class="resolved" data-resolved>COST / MILE</span>
        <span class="stub-label resolved-caption" data-resolved>the number AutoMate calculates for you</span>
      </div>
    </div>

    <div class="hero-cta">
      <PlayStoreButton />
      <span class="hero-cta-note">Free to start · $9.99 once for unlimited vehicles</span>
    </div>
  </div>
</section>

<script>
  const receipts = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReduced) {
    receipts.forEach((el) => el.classList.add('is-resolved'));
  } else if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            window.setTimeout(() => target.classList.add('is-resolved'), 700);
            observer.unobserve(target);
          }
        }
      },
      { threshold: 0.6 }
    );
    receipts.forEach((el) => observer.observe(el));
  } else {
    receipts.forEach((el) => el.classList.add('is-resolved'));
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--road);
    color: var(--ticket-paper);
    padding: clamp(3rem, 8vw, var(--space-4xl)) clamp(1.25rem, 4vw, 3rem) clamp(4rem, 10vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }
  .road-texture {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 45% at 50% 0%, color-mix(in srgb, var(--primary) 22%, transparent), transparent 70%),
      repeating-linear-gradient(
        90deg,
        var(--road-line) 0 2px,
        transparent 2px 64px
      );
    background-position: 0 100%;
    background-repeat: no-repeat, repeat-x;
    background-size: 100% 100%, auto 2px;
    opacity: 0.9;
  }
  .hero-inner {
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }
  h1 {
    font-size: clamp(2.25rem, 5vw + 1rem, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
  }
  .hero-sub {
    font-size: clamp(1.05rem, 1.5vw + 0.5rem, 1.35rem);
    color: color-mix(in srgb, var(--ticket-paper) 78%, transparent);
    max-width: 40ch;
  }

  .ticket-receipt {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-block: var(--space-xl);
    flex-wrap: wrap;
    justify-content: center;
  }
  .ticket,
  .receipt {
    background: var(--ticket-paper);
    color: var(--ink);
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-xl);
    display: grid;
    grid-template-columns: auto auto;
    column-gap: var(--space-md);
    row-gap: var(--space-xs);
    text-align: left;
    min-width: 12rem;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.6);
  }
  .ticket {
    border-right: 2px dashed var(--divider);
  }
  .stub-label {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    align-self: center;
  }
  .stub-value {
    grid-column: 2;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
  }
  .lane {
    display: flex;
    align-items: center;
    color: var(--road-line);
    font-size: 1.5rem;
  }
  .lane-arrow {
    color: var(--primary);
  }

  .receipt {
    position: relative;
    min-height: 4.5rem;
    align-content: center;
  }
  .redacted {
    grid-column: 2;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    transition: opacity 420ms var(--ease-out-quart);
  }
  .resolved {
    grid-column: 2;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--primary);
    opacity: 0;
    position: absolute;
    transform: translateY(4px);
    transition: opacity 420ms var(--ease-out-quart), transform 420ms var(--ease-out-quart);
  }
  .resolved-caption {
    grid-column: 2;
    font-size: 0.65rem;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    color: var(--ink-muted);
    top: 1.6rem;
  }
  .receipt.is-resolved .redacted {
    opacity: 0;
  }
  .receipt.is-resolved .resolved {
    opacity: 1;
    transform: translateY(0);
    position: static;
  }
  .receipt:not(.is-resolved) .resolved {
    pointer-events: none;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
  .hero-cta-note {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--ticket-paper) 60%, transparent);
  }

  @media (max-width: 30rem) {
    .ticket-receipt {
      flex-direction: column;
    }
    .lane {
      transform: rotate(90deg);
    }
    .ticket {
      border-right: none;
      border-bottom: 2px dashed var(--divider);
    }
  }
</style>
