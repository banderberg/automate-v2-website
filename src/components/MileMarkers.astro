---
import { mileMarkers } from '../lib/content';
---

<section class="mile-markers" aria-labelledby="dashboard-heading">
  <div class="horizon" aria-hidden="true"></div>
  <div class="section-inner">
    <h2 id="dashboard-heading">The dashboard, at a glance.</h2>
    <p class="lede">Three numbers most car owners have never seen in one place.</p>
    <ol class="markers">
      {
        mileMarkers.map((m) => (
          <li class="marker">
            <span class="marker-post" aria-hidden="true">{m.marker}</span>
            <div class="tick" aria-hidden="true"></div>
            <h3>{m.label}</h3>
            <p>{m.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .mile-markers {
    background: var(--surface);
    padding: 0 clamp(1.25rem, 4vw, 3rem) var(--space-4xl);
  }
  .horizon {
    height: clamp(4rem, 12vw, 7rem);
    margin: 0 calc(-1 * clamp(1.25rem, 4vw, 3rem));
    background: linear-gradient(180deg, var(--road) 0%, var(--surface) 100%);
  }
  .section-inner {
    padding-top: var(--space-4xl);
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
  }
  h2 {
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
    font-weight: 700;
    color: var(--ink);
  }
  .lede {
    color: var(--ink-secondary);
    margin: var(--space-md) auto var(--space-3xl);
    max-width: 42ch;
  }
  .markers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-2xl);
    position: relative;
  }
  .marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .marker-post {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
  }
  .tick {
    width: 2px;
    height: 1.75rem;
    background: var(--primary);
    margin: var(--space-sm) 0 var(--space-lg);
  }
  .marker h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-sm);
  }
  .marker p {
    color: var(--ink-secondary);
    font-size: 0.95rem;
    max-width: 26ch;
  }
</style>
