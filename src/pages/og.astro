---
// Utility route rendered once at build time (via screenshot) to produce
// public/og.png. Not part of the sitemap or nav — noindex as a safety net.
import '../styles/global.css';
import { withBase } from '../lib/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>AutoMate OG Card</title>
  </head>
  <body>
    <div class="og-card">
      <div class="og-brand">
        <img src={withBase('/favicon.png')} alt="" width="40" height="40" />
        <span>AutoMate</span>
      </div>
      <div class="og-main">
        <h1>You already paid this.<br />You just don't know the number.</h1>
        <div class="og-ticket-receipt">
          <div class="og-ticket">
            <span>ENTRY 08:14</span>
            <span>MILE 000</span>
          </div>
          <span class="og-arrow">→</span>
          <div class="og-receipt">
            <span class="og-receipt-label">EXIT</span>
            <span class="og-receipt-value">COST / MILE</span>
          </div>
        </div>
      </div>
      <p class="og-tagline">Track fuel, service &amp; expenses. Private, no accounts, fully offline.</p>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }
  .og-card {
    width: 1200px;
    height: 630px;
    background: var(--road);
    background-image: radial-gradient(
      60% 60% at 50% 0%,
      color-mix(in srgb, var(--primary) 24%, transparent),
      transparent 70%
    );
    color: var(--ticket-paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 3.5rem 4rem;
    box-sizing: border-box;
    font-family: var(--font-body);
  }
  .og-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
  }
  .og-brand img {
    border-radius: 9px;
  }
  .og-main h1 {
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
    max-width: 18ch;
  }
  .og-ticket-receipt {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .og-ticket,
  .og-receipt {
    background: var(--ticket-paper);
    color: var(--ink);
    border-radius: 12px;
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .og-arrow {
    color: var(--primary);
    font-size: 2rem;
  }
  .og-receipt-label {
    font-size: 0.7rem;
    color: var(--ink-muted);
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .og-receipt-value {
    color: var(--primary);
  }
  .og-tagline {
    font-size: 1.15rem;
    color: color-mix(in srgb, var(--ticket-paper) 78%, transparent);
    margin: 0;
  }
</style>
