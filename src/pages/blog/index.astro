---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) =>
    (b.data.updatedDate ?? b.data.pubDate).getTime() - (a.data.updatedDate ?? a.data.pubDate).getTime(),
);

const human = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const path = '/blog/';
---

<BaseLayout
  title="Blog: car running costs, maintenance and switching apps | AutoMate"
  description="Plain guides to what a car really costs: cost per mile, a maintenance schedule you can check against your manual, and an honest look at Fuelio and Drivvo."
  path={path}
  ogSlug="blog"
  breadcrumbs={[{ name: 'Blog', path }]}
>
  <div class="blog wrap">
    <header class="doc-head">
      <h1>Blog</h1>
      <p class="lede">Notes on what a car really costs to run, and how to keep track of it.</p>
    </header>
    <ol class="post-list">
      {
        posts.map((post) => (
          <li>
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <p class="muted post-date">
              <time datetime={(post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10)}>
                {post.data.updatedDate ? 'Updated ' : ''}
                {human(post.data.updatedDate ?? post.data.pubDate)}
              </time>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .blog {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) 0;
  }
  .doc-head h1 {
    font-size: clamp(2.25rem, 3.4vw + 1rem, 3.5rem);
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-ink);
    max-width: 48rem;
  }
  .post-list li {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }
  .post-list h2 {
    font-size: var(--text-lg);
  }
  .post-list h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .post-list h2 a:hover {
    color: var(--color-link);
    text-decoration: underline;
  }
  .post-list p {
    color: var(--color-ink-2);
  }
  .post-date {
    font-size: var(--text-sm);
  }
</style>
