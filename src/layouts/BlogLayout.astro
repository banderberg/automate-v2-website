---
import BaseLayout from './BaseLayout.astro';
import PlayLink from '../components/PlayLink.astro';
import { PRICING_LINE } from '../lib/facts';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  updatedDate?: Date;
}

const { title, description, slug, pubDate, updatedDate } = Astro.props;
const path = `/blog/${slug}/`;
const site = Astro.site ?? new URL('https://automateapp.info');

const isoDay = (d: Date) => d.toISOString().slice(0, 10);
const human = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDay(pubDate),
  dateModified: isoDay(updatedDate ?? pubDate),
  mainEntityOfPage: new URL(path, site).toString(),
  image: new URL(`/og/blog-${slug}.png`, site).toString(),
  author: { '@type': 'Organization', name: 'AutoMate' },
  publisher: { '@type': 'Organization', name: 'AutoMate', logo: new URL('/icon-192.png', site).toString() },
};
---

<BaseLayout
  title={`${title} | AutoMate`}
  description={description}
  path={path}
  ogSlug={`blog-${slug}`}
  ogType="article"
  structuredData={[article]}
  breadcrumbs={[
    { name: 'Blog', path: '/blog/' },
    { name: title, path },
  ]}
>
  <article class="doc wrap">
    <header class="doc-head">
      <h1>{title}</h1>
      <p class="muted post-date">
        {
          updatedDate ? (
            <>
              Updated <time datetime={isoDay(updatedDate)}>{human(updatedDate)}</time>
            </>
          ) : (
            <time datetime={isoDay(pubDate)}>{human(pubDate)}</time>
          )
        }
      </p>
    </header>
    <div class="doc-body">
      <slot />
    </div>
    <aside class="post-cta" aria-label="Get AutoMate">
      <p class="post-cta-title">Track your own numbers</p>
      <p class="muted">AutoMate logs fuel, service and expenses on your Android phone. {PRICING_LINE}</p>
      <PlayLink />
    </aside>
  </article>
</BaseLayout>

<style>
  .post-date {
    font-size: var(--text-sm);
  }
  .post-cta {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    padding-top: var(--space-xl);
    border-top: 2px solid var(--color-ink);
  }
  .post-cta-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }
</style>
